   "outputs": [],
   "source": "# ── Chargement du CSV ────────────────────────────────────────────\nif os.path.exists(STYLE_CONFIG['csv_path']):\n    df = pd.read_csv(STYLE_CONFIG['csv_path'])\n    print(f\"✅ CSV chargé : {len(df)} lignes | {df['n_clients'].nunique()} tailles\")\n    display(df.head(8))\nelse:\n    print(\"⚠️  CSV introuvable — génération de données simulées pour la démo\")\n    print(\"   Lancez d'abord : python grands_tests/grands_tests_genetique.py\")\n    np.random.seed(42)\n    rows = []\n    params_sim = {\n        10:  (1800, 150,  2.5,  0.4, 3.0, 0.3),\n        20:  (3200, 280,  8.1,  1.2, 3.8, 0.4),\n        50:  (7800, 620, 28.4,  4.1, 5.5, 0.6),\n        100: (15200,1100, 95.2, 12.3, 8.2, 0.9),\n        200: (29500,2200,320.1, 38.7,12.1, 1.2),\n    }\n    for n, (cm, cs, tm, ts, vm, vs) in params_sim.items():\n        for run in range(30):\n            rows.append({\n                'n_clients'        : n, 'run': run+1,\n                'cout'             : max(0, np.random.normal(cm, cs)),\n                'temps_s'          : max(0, np.random.normal(tm, ts)),\n                'n_vehicules'      : max(1, int(np.random.normal(vm, vs))),\n                'amelioration_pct' : np.random.uniform(8, 25),\n                'c1_respectee'     : 1,\n            })\n    df = pd.DataFrame(rows)\n    print(f\"✅ Données simulées : {len(df)} lignes\")\n    display(df.head(8))\n"
